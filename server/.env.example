# Copy to .env and fill in. The server reads process.env; use a tool like
# `node --env-file=.env src/server.js` (Node 20+) or `dotenv`/`direnv`.

# Required — your Postgres connection string
DATABASE_URL=postgres://poke:poke@localhost:5432/poke

# Port to listen on
PORT=4000

# Allowed browser origins for CORS, comma-separated. Each entry is:
#   *                        any origin (only ok for internal/trusted use)
#   https://app.example.com  an exact origin
#   https://*.example.com    any single-label subdomain (scheme must match)
# Include the scheme and port. Examples:
#   POKE_ORIGINS=http://localhost:3000
#   POKE_ORIGINS=https://app.modools.app,https://*.modools.app
POKE_ORIGINS=http://localhost:3000

# Logical namespace for this deployment's comments. Bump it to wipe/segregate.
POKE_PROJECT=modools

# Max request body size in bytes
POKE_MAX_BODY=100000

# SSL to Postgres: "1" force on, "0" force off. Default: on unless host is
# localhost. Managed Postgres (Railway/Fly/Render/Supabase/Neon) needs it on.
# PGSSL=1
