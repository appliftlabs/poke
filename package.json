{
  "name": "@appliftlabs/poke",
  "version": "0.1.1",
  "description": "Figma-style pinned comments for any live web page. Drop-in, element-anchored, open source.",
  "license": "MIT",
  "author": "Applift Labs",
  "homepage": "https://github.com/yusuf-ishaku/poke#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusuf-ishaku/poke.git"
  },
  "bugs": {
    "url": "https://github.com/yusuf-ishaku/poke/issues"
  },
  "keywords": [
    "comments",
    "annotations",
    "feedback",
    "bug-reporting",
    "review",
    "figma-style"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/poke.global.js",
  "jsdelivr": "./dist/poke.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./global": "./dist/poke.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "preact": "^10.25.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
